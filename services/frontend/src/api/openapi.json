{
  "components": {
    "schemas": {
      "AdminOrderView": {
        "description": "One order in the instructor overview. It never names the guest or carries the failure reason.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "fulfillment_attempts": {
            "description": "Fulfillment attempts the worker has started (at most four).",
            "title": "Fulfillment Attempts",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "item_count": {
            "description": "Units in the order.",
            "title": "Item Count",
            "type": "integer"
          },
          "publication_pending": {
            "description": "True until the order has been handed to the fulfillment queue.",
            "title": "Publication Pending",
            "type": "boolean"
          },
          "receipt_available": {
            "title": "Receipt Available",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "accepted",
              "processing",
              "fulfilled",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "total_cents": {
            "title": "Total Cents",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "status",
          "publication_pending",
          "fulfillment_attempts",
          "item_count",
          "total_cents",
          "created_at",
          "receipt_available"
        ],
        "title": "AdminOrderView",
        "type": "object"
      },
      "AdminOrdersView": {
        "properties": {
          "orders": {
            "description": "The 50 most recent orders of every guest, newest first.",
            "items": {
              "$ref": "#/components/schemas/AdminOrderView"
            },
            "title": "Orders",
            "type": "array"
          },
          "publication_pending": {
            "description": "Accepted orders not yet handed to the fulfillment queue.",
            "title": "Publication Pending",
            "type": "integer"
          },
          "status_counts": {
            "$ref": "#/components/schemas/OrderStatusCounts",
            "description": "All orders by status."
          }
        },
        "required": [
          "status_counts",
          "publication_pending",
          "orders"
        ],
        "title": "AdminOrdersView",
        "type": "object"
      },
      "CartItemQuantity": {
        "additionalProperties": false,
        "properties": {
          "quantity": {
            "description": "The line's new quantity (replaces, not adds).",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "quantity"
        ],
        "title": "CartItemQuantity",
        "type": "object"
      },
      "CartItemView": {
        "properties": {
          "product_id": {
            "format": "uuid",
            "title": "Product Id",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          },
          "unit_price_cents": {
            "description": "The product's current price; checkout re-prices on the server.",
            "title": "Unit Price Cents",
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "quantity",
          "unit_price_cents"
        ],
        "title": "CartItemView",
        "type": "object"
      },
      "CartView": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CartItemView"
            },
            "title": "Items",
            "type": "array"
          },
          "total_cents": {
            "title": "Total Cents",
            "type": "integer"
          },
          "version": {
            "description": "Starts at 0 and increases by exactly 1 with every change to the cart.",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version",
          "items",
          "total_cents"
        ],
        "title": "CartView",
        "type": "object"
      },
      "CheckoutRequest": {
        "additionalProperties": false,
        "properties": {
          "cart_version": {
            "description": "The `version` of the cart the shopper reviewed; checkout refuses a cart that changed since.",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Cart Version",
            "type": "integer"
          },
          "payment_outcome": {
            "description": "Simulated payment result. No real payment is taken.",
            "enum": [
              "approved",
              "declined"
            ],
            "title": "Payment Outcome",
            "type": "string"
          }
        },
        "required": [
          "cart_version",
          "payment_outcome"
        ],
        "title": "CheckoutRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InstructorCredentials": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "InstructorCredentials",
        "type": "object"
      },
      "OrderItemView": {
        "properties": {
          "name": {
            "description": "Product name at checkout.",
            "title": "Name",
            "type": "string"
          },
          "product_id": {
            "format": "uuid",
            "title": "Product Id",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          },
          "unit_price_cents": {
            "description": "Price charged per unit at checkout, in US cents.",
            "title": "Unit Price Cents",
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "name",
          "quantity",
          "unit_price_cents"
        ],
        "title": "OrderItemView",
        "type": "object"
      },
      "OrderStatusCounts": {
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "integer"
          },
          "failed": {
            "title": "Failed",
            "type": "integer"
          },
          "fulfilled": {
            "title": "Fulfilled",
            "type": "integer"
          },
          "processing": {
            "title": "Processing",
            "type": "integer"
          }
        },
        "required": [
          "accepted",
          "processing",
          "fulfilled",
          "failed"
        ],
        "title": "OrderStatusCounts",
        "type": "object"
      },
      "OrderView": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemView"
            },
            "title": "Items",
            "type": "array"
          },
          "publication_pending": {
            "description": "True until the order has been handed to the fulfillment queue.",
            "title": "Publication Pending",
            "type": "boolean"
          },
          "receipt_available": {
            "title": "Receipt Available",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "accepted",
              "processing",
              "fulfilled",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "total_cents": {
            "title": "Total Cents",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "status",
          "publication_pending",
          "total_cents",
          "created_at",
          "receipt_available",
          "items"
        ],
        "title": "OrderView",
        "type": "object"
      },
      "ProductView": {
        "properties": {
          "currency": {
            "const": "USD",
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "image_path": {
            "description": "Storefront path of the product image.",
            "title": "Image Path",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price_cents": {
            "description": "Price in US cents.",
            "title": "Price Cents",
            "type": "integer"
          },
          "sku": {
            "title": "Sku",
            "type": "string"
          },
          "stock": {
            "description": "Units available now.",
            "title": "Stock",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "description",
          "price_cents",
          "currency",
          "stock",
          "image_path"
        ],
        "title": "ProductView",
        "type": "object"
      },
      "ReceiptView": {
        "properties": {
          "currency": {
            "const": "USD",
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "issued_at": {
            "format": "date-time",
            "title": "Issued At",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemView"
            },
            "title": "Items",
            "type": "array"
          },
          "order_id": {
            "format": "uuid",
            "title": "Order Id",
            "type": "string"
          },
          "total_cents": {
            "title": "Total Cents",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "order_id",
          "issued_at",
          "items",
          "total_cents",
          "currency"
        ],
        "title": "ReceiptView",
        "type": "object"
      },
      "SessionView": {
        "description": "A live session's CSRF token. The session token itself travels only in its HTTP-only cookie.",
        "properties": {
          "csrf_token": {
            "description": "Send as the X-CSRF-Token header on every state-changing request.",
            "title": "Csrf Token",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "csrf_token",
          "expires_at"
        ],
        "title": "SessionView",
        "type": "object"
      },
      "StockUpdate": {
        "additionalProperties": false,
        "properties": {
          "stock": {
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Stock",
            "type": "integer"
          }
        },
        "required": [
          "stock"
        ],
        "title": "StockUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionView": {
        "properties": {
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "VersionView",
        "type": "object"
      }
    },
    "securitySchemes": {
      "GuestSession": {
        "description": "HTTP-only cookie set by GET /api/v1/session.",
        "in": "cookie",
        "name": "cloudcart_guest",
        "type": "apiKey"
      },
      "InstructorSession": {
        "description": "HTTP-only cookie set by POST /api/v1/admin/login.",
        "in": "cookie",
        "name": "cloudcart_instructor",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "CloudCart",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/login": {
      "post": {
        "description": "Start an instructor session and set its cookie. Every failure is the same 401.",
        "operationId": "log_in_api_v1_admin_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstructorCredentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Log In",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/admin/logout": {
      "post": {
        "description": "End the caller's instructor session and clear its cookie. Other instructor sessions stay live.",
        "operationId": "log_out_api_v1_admin_logout_post",
        "parameters": [
          {
            "description": "Required on state-changing requests: the csrf_token returned with the caller's session.",
            "in": "header",
            "name": "X-CSRF-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Required on state-changing requests: the csrf_token returned with the caller's session.",
              "title": "X-Csrf-Token"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "InstructorSession": []
          }
        ],
        "summary": "Log Out",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/admin/orders": {
      "get": {
        "description": "Every guest's 50 most recent orders and counts over all orders (instructor only).",
        "operationId": "read_order_overview_api_v1_admin_orders_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOrdersView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "InstructorSession": []
          }
        ],
        "summary": "Read Order Overview",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/products/{product_id}/stock": {
      "put": {
        "description": "Set a product's available stock (instructor only).",
        "operationId": "set_stock_api_v1_admin_products__product_id__stock_put",
        "parameters": [
          {
            "in": "path",
            "name": "product_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Product Id",
              "type": "string"
            }
          },
          {
            "description": "Required on state-changing requests: the csrf_token returned with the caller's session.",
            "in": "header",
            "name": "X-CSRF-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Required on state-changing requests: the csrf_token returned with the caller's session.",
              "title": "X-Csrf-Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "InstructorSession": []
          }
        ],
        "summary": "Set Stock",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/admin/session": {
      "get": {
        "description": "Return the caller's live instructor session, so the instructor view survives a page reload. 401 otherwise.",
        "operationId": "resume_instructor_session_api_v1_admin_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "InstructorSession": []
          }
        ],
        "summary": "Resume Instructor Session",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/cart": {
      "get": {
        "description": "The caller's cart; the first read creates it empty at version 0.",
        "operationId": "read_cart_api_v1_cart_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "GuestSession": []
          }
        ],
        "summary": "Read Cart",
        "tags": [
          "cart"
        ]
      }
    },
    "/api/v1/cart/items/{product_id}": {
      "delete": {
        "description": "Remove a product from the caller's cart and return the updated cart. 404: not in the cart.",
        "operationId": "remove_item_api_v1_cart_items__product_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "product_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Product Id",
              "type": "string"
            }
          },
          {
            "description": "Required on state-changing requests: the csrf_token returned with the caller's session.",
            "in": "header",
            "name": "X-CSRF-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Required on state-changing requests: the csrf_token returned with the caller's session.",
              "title": "X-Csrf-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "GuestSession": []
          }
        ],
        "summary": "Remove Item",
        "tags": [
          "cart"
        ]
      },
      "put": {
        "description": "Set a product's quantity in the caller's cart. 404: unknown product; 409: line or stock limit.",
        "operationId": "set_item_api_v1_cart_items__product_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "product_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Product Id",
              "type": "string"
            }
          },
          {
            "description": "Required on state-changing requests: the csrf_token returned with the caller's session.",
            "in": "header",
            "name": "X-CSRF-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Required on state-changing requests: the csrf_token returned with the caller's session.",
              "title": "X-Csrf-Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CartItemQuantity"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "GuestSession": []
          }
        ],
        "summary": "Set Item",
        "tags": [
          "cart"
        ]
      }
    },
    "/api/v1/orders": {
      "get": {
        "description": "The caller's 50 most recent orders, newest first.",
        "operationId": "read_orders_api_v1_orders_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OrderView"
                  },
                  "title": "Response Read Orders Api V1 Orders Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "GuestSession": []
          }
        ],
        "summary": "Read Orders",
        "tags": [
          "orders"
        ]
      },
      "post": {
        "description": "Check out the caller's cart at current prices: charge stock, accept the order, and empty the cart.",
        "operationId": "place_order_api_v1_orders_post",
        "parameters": [
          {
            "description": "A new random value (8\u2013128 of A-Z a-z 0-9 _ -) per checkout; resend it unchanged on retries.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "description": "A new random value (8\u2013128 of A-Z a-z 0-9 _ -) per checkout; resend it unchanged on retries.",
              "pattern": "^[A-Za-z0-9_-]{8,128}$",
              "title": "Idempotency-Key",
              "type": "string"
            }
          },
          {
            "description": "Required on state-changing requests: the csrf_token returned with the caller's session.",
            "in": "header",
            "name": "X-CSRF-Token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
